# ========================
# BACKEND (backend/.env)
# ========================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev: points at your own docker-compose Postgres. For the shared/hosted
# environment, use the Render Postgres connection string instead (ask Handre).
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/muniprioritise

# JWT secret — use a long random string, keep it private
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# URL where the Python algorithm microservice is running
# Local dev: localhost is correct here, since backend and algorithm run on the
# same machine. For shared/hosted, use the deployed Render URL instead.
ALGORITHM_SERVICE_URL=http://localhost:8000

# Cloudinary — for photo uploads (get free credentials at cloudinary.com)
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Port the backend runs on
PORT=3000


# ========================
# ALGORITHM SERVICE (algorithm/.env)
# ========================

PORT=8000


# ========================
# MOBILE APP (mobile/app.config.js)
# ========================
# Set this in app.config.js, not a .env file.
#
# DO NOT default this to http://localhost:3000 — on a phone or emulator,
# "localhost" means the device itself, not your laptop, so every request
# will silently fail to connect.
#
# Default to the shared Render-hosted backend so it works for everyone
# without extra setup:
# API_BASE_URL=https://muniprioritise-backend.onrender.com/api/v1
#
# Only override this if you're specifically testing your own local backend
# changes:
#   Physical device on same WiFi: your laptop's LAN IP, e.g.
#     API_BASE_URL=http://192.168.1.42:3000/api/v1
#   Android emulator specifically:
#     API_BASE_URL=http://10.0.2.2:3000/api/v1


# ========================
# DASHBOARD (dashboard/.env)
# ========================

# Vite only exposes vars prefixed VITE_ to the client.
# Local dev (dashboard and backend both running on your own machine): localhost is fine.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# For testing against the shared/hosted backend instead:
# VITE_API_BASE_URL=https://muniprioritise-backend.onrender.com/api/v1


# ========================
# NOTES
# ========================
# - Copy this file to .env in each sub-project folder and fill in your values
# - NEVER commit your actual .env file — it is in .gitignore
# - Ask in the group chat if you're unsure what value to use for a variable
# - Two environments exist: local (your own machine, docker-compose Postgres)
#   and shared/hosted (Render backend + algorithm + hosted Postgres, Vercel
#   dashboard). Use shared/hosted whenever you want to confirm a real
#   end-to-end flow with the rest of the team.

