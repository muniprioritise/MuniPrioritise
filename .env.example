# Backend: copy the variables in this section to backend/.env

# PostgreSQL connection string. This value matches the docker-compose database.
DATABASE_URL=postgresql://muni_user:muni_pass@localhost:5432/muniprioritise

# Signs login tokens. Use a long random string. The server will not start without it.
JWT_SECRET=replace-this-with-a-long-random-string

# Base URL of the algorithm service. Local: http://localhost:8000
# Hosted: https://muniprioritise.onrender.com
ALGORITHM_SERVICE_URL=http://localhost:8000

# Photo storage (cloudinary.com). Without it, photos are saved to backend/uploads,
# which is fine for local development only.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Optional. Defaults to 3000.
PORT=3000


# Algorithm service: set these in the environment where it runs

# Optional. When set, PATCH /prioritise/config requires a matching X-Config-Key header.
CONFIG_API_KEY=


# Dashboard: copy to dashboard/.env

# Backend address WITHOUT /api, because the app adds it.
# Vite reads this at build time, so rebuild after changing it.
VITE_API_BASE_URL=http://localhost:3000
# Hosted backend: https://muniprioritise-1vgj.onrender.com


# Mobile app
# There is no .env file. The backend address is API_BASE_URL in mobile/config/api.ts.
# It points at the hosted backend. For a local backend, use your computer's LAN IP on a
# phone (http://192.168.1.42:3000) or http://10.0.2.2:3000 on an Android emulator.
# "localhost" will not work, because on a phone it means the phone itself.
